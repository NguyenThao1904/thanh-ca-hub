# Settings for the Thánh Ca Hub server. Copy this file to backend/.env and adjust.
# Every setting can also be given as an environment variable (e.g. on a hosting
# platform). All of them are optional: the defaults run the app locally.

# Shown in the browser tab, on the sign-in page and in the sidebar.
APP_NAME=Thánh Ca Hub
# Language for people who have not chosen one: vi or en.
DEFAULT_LOCALE=vi
# Dates are shown in this time zone.
TIME_ZONE=Asia/Ho_Chi_Minh

# --- Database -------------------------------------------------------------------
# Folder for the SQLite database and (with local storage) the uploaded files.
DATA_DIR=data
# Empty: SQLite file DATA_DIR/thanhca.db (fine for one server).
# Or PostgreSQL, e.g. from Neon, Supabase or your own server:
# DATABASE_URL=postgresql://user:password@host:5432/thanhca
DATABASE_URL=
# Create/update the tables when the server starts.
AUTO_MIGRATE=true

# --- Uploaded scans and PDFs ----------------------------------------------------------
# local: stored in DATA_DIR/files (or FILES_DIR). Needs a persistent disk.
# s3: any S3-compatible bucket (Cloudflare R2, Amazon S3, Google Cloud Storage
#     with HMAC keys, MinIO, Supabase Storage). The bucket must stay private.
STORAGE_BACKEND=local
# FILES_DIR=
# S3_BUCKET=
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=

# --- Sign-in ------------------------------------------------------------------------
# People stay signed in this many days after their last visit.
SESSION_DAYS=30
# auto: secure cookies when the site is served over HTTPS (behind a proxy, start
# uvicorn with --proxy-headers so it knows). true/false to force.
COOKIE_SECURE=auto

# --- Other ---------------------------------------------------------------------------
# The built web app (npm run build in frontend/). Default: ../frontend/dist
# FRONTEND_DIST=
LOG_LEVEL=INFO
